{
  "name": "pokesleep-kitchen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "download-wiki": "node scripts/download-wiki.js",
    "parse-wiki": "node scripts/parse-wiki-data.js",
    "fetch-data": "npm run download-wiki && npm run parse-wiki",
    "download-recipe-wiki": "node scripts/download-recipe-wiki.js",
    "parse-recipe": "node scripts/parse-recipe-data.js",
    "fetch-recipe-data": "npm run download-recipe-wiki && npm run parse-recipe",
    "download-ingredient-wiki": "node scripts/download-ingredient-wiki.js",
    "parse-ingredient": "node scripts/parse-ingredient-data.js",
    "fetch-ingredient-data": "npm run download-ingredient-wiki && npm run parse-ingredient"
  },
  "dependencies": {
    "cheerio": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.2.0",
    "vite": "^5.4.11"
  }
}
